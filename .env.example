# Photon project credentials — get these with the Photon CLI, see README
PROJECT_ID=
PROJECT_SECRET=

# The phone number that should route to this project, in E.164 format
TARGET_PHONE=+8613800138000

# Any OpenAI-compatible chat completions endpoint (official API, or a relay/proxy)
RELAY_BASE_URL=https://api.deepseek.com
RELAY_API_KEY=
RELAY_MODEL=deepseek-chat

# Optional — omit both to disable [voice] lines
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional — local port for the /send push endpoint (used by cron scripts, etc.)
PORT=4001
